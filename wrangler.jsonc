{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mw-rentals",
  // Keep current with today's date when creating or bumping this Worker.
  "compatibility_date": "2026-11-09",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
